{
  "schema_version": "memory-mcp-agent-managed-maintenance-host-policy/v3",
  "codex_binary": "/opt/homebrew/bin/codex",
  "codex_version": "codex-cli 0.171.0",
  "authentication": "existing local Codex home; no API key copied to runner artifacts",
  "ephemeral_session": true,
  "ignore_user_config": true,
  "ignore_exec_rules": true,
  "sandbox": "read-only",
  "disabled_codex_features": [
    "apps",
    "memories",
    "plugins",
    "request_permissions_tool",
    "shell_tool"
  ],
  "web_search": "disabled",
  "mcp_server": "required local memory_decisions stdio server",
  "maintenance_tool_allowlist": [
    "assemble_context",
    "extract",
    "invalidate"
  ],
  "recall_tool_allowlist": [
    "assemble_context"
  ],
  "independent_probe": "direct MCP call by evaluator; no agent session",
  "outer_host_execution": "direct host launch authorized by user; Codex retains its own read-only sandbox"
}
