{
  "schema_version": "memory-mcp-agent-managed-protocol/v2",
  "transport": "stdio",
  "formation": {
    "enabled_tools": [
      "ingest",
      "extract"
    ],
    "fresh_agent_session": true,
    "max_ingest_calls_per_fact": 1,
    "max_extract_calls_per_fact": 1,
    "reads_enabled": false,
    "wall_time_budget_seconds": 120
  },
  "recall": {
    "enabled_tools": [
      "assemble_context"
    ],
    "fresh_agent_session": true,
    "same_trial_store": true,
    "wall_time_budget_seconds": 120
  },
  "independent_probe": {
    "enabled_tools": [
      "assemble_context"
    ],
    "runs_after_recall": true,
    "agent_session": false,
    "same_trial_store": true
  },
  "tool_timeout_seconds": 120,
  "context_output_token_limit": 8192
}
