+#[tokio::test]
+#[ignore = "requires a disposable full snapshot; metadata only, not retrieval or quality acceptance"]
+async fn full_history_payload_inventory() {
+    use memory_mcp::storage::DbClient;
+
+    let db = connect_snapshot().await;
+    for (kind, sql) in [
+        (
+            "fact_count",
+            "SELECT count() AS records FROM fact GROUP ALL".to_owned(),
+        ),
+        (
+            "fact_payload",
+            format!("SELECT {PAYLOAD_FIELDS} FROM fact LIMIT 10000"),
+        ),
+        (
+            "episode_count",
+            "SELECT count() AS records FROM episode GROUP ALL".to_owned(),
+        ),
+        (
+            "episode_payload",
+            format!("SELECT {PAYLOAD_FIELDS} FROM episode LIMIT 10000"),
+        ),
+    ] {
+        println!(
+            "FULL_HISTORY_INVENTORY_START {}",
+            serde_json::json!({"kind":kind,"sql":sql})
+        );
+        std::io::stdout().flush().unwrap();
+        let started = Instant::now();
+        let rows = db.query(&sql, None, "main").await.unwrap();
+        println!(
+            "FULL_HISTORY_INVENTORY {}",
+            serde_json::json!({"kind":kind,"elapsed_ms":started.elapsed().as_secs_f64()*1000.0,"rows":rows})
+        );
+        std::io::stdout().flush().unwrap();
+    }
+}
