+
+#[tokio::test]
+async fn graph_batch_plan_uses_two_endpoint_set_lookups() {
+    let (_, db) = common::make_service_with_client().await;
+    let seeds = (0..32)
+        .map(|n| format!("entity:set_seed_{n:02}"))
+        .collect::<Vec<_>>();
+    let (sql, vars) =
+        build_select_edge_neighbors_for_entities_query(&seeds, "2026-05-01T00:00:00Z");
+    let plan = db
+        .query(&format!("{sql} EXPLAIN"), Some(vars), "org")
+        .await
+        .unwrap();
+    fn index_scans(node: &Value) -> usize {
+        usize::from(matches!(
+            node["attributes"]["index"].as_str(),
+            Some("edge_in" | "edge_out")
+        )) + node
+            .get("children")
+            .and_then(Value::as_array)
+            .map_or(0, |children| children.iter().map(index_scans).sum())
+    }
+    let count: usize = plan.as_array().unwrap().iter().map(index_scans).sum();
+    assert_eq!(
+        count, 2,
+        "a32-seed batch should plan one set lookup per endpoint, not64 separate query branches: {plan}"
+    );
+    let serialized = plan.to_string();
+    assert!(!serialized.contains("TableScan"));
+    assert!(serialized.contains("edge_in"));
+    assert!(serialized.contains("edge_out"));
+}
