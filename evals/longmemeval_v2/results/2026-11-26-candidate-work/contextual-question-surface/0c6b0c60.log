FULL_HISTORY_QUERY {"duration_us":53098,"elapsed_ms":24573.492667,"sql":"UPDATE type::record('fact', $fact_id) SET access_count = IF access_count IS NONE OR access_count IS NULL THEN $boost ELSE IF $boost > 0 THEN IF access_count > $int_max - $boost THEN $int_max ELSE access_count + $boost END ELSE IF $boost < 0 THEN IF access_count < $int_min - $boost THEN $int_min ELSE access_count + $boost END ELSE access_count END, last_accessed = type::datetime($last_accessed) RETURN NONE"}
