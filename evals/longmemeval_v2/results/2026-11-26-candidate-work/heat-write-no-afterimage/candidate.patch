+/// First-hit union after each term's own order/cap, then same-view hydration.
+pub(crate) fn build_select_episode_candidate_batch_query(
+    cutoff: &str,
+    terms: &[String],
+    limit: i32,
+    seen: &[String],
+) -> (String, Value) {
+    let mut vars = serde_json::Map::from_iter([
+        ("cutoff".into(), json!(cutoff)),
+        ("limit".into(), json!(limit)),
+        ("seen".into(), json!(seen)),
+    ]);
+    let groups = terms.iter().enumerate().map(|(rank, term)| {
+        vars.insert(format!("query_{rank}"), json!(term.to_lowercase()));
+        let content_filter = if term.trim().is_empty() {
+            String::new()
+        } else {
+            format!(" AND string::contains(string::lowercase(content), $query_{rank})")
+        };
+        format!("(SELECT record, episode_id, t_ref, term_rank FROM (SELECT id AS record, episode_id, t_ref, {rank} AS term_rank FROM episode WHERE t_ref <= type::datetime($cutoff) AND (t_ingested IS NONE OR t_ingested <= type::datetime($cutoff)){content_filter}) ORDER BY t_ref DESC, episode_id ASC LIMIT $limit)")
+    }).collect::<Vec<_>>().join(", ");
+    (
+        format!(
+            "SELECT VALUE record.* FROM (SELECT hit[1] AS record, hit[2] AS episode_id, hit[3] AS t_ref, hit[0] AS term_rank FROM (SELECT episode_id, array::min([term_rank, record, episode_id, t_ref]) AS hit FROM array::flatten([{groups}]) GROUP BY episode_id) ORDER BY term_rank ASC, t_ref DESC, episode_id ASC) WHERE episode_id NOT IN $seen"
+        ),
+        Value::Object(vars),
+    )
+}
