+fn index_topic_features(query: &QueryEvidence, keys: &[String]) -> IndexTopicFeatures {
+    let references = if query.qualified_references.is_empty()
+        && query.mandatory_reference_alternatives.is_empty()
+    {
+        Vec::new()
+    } else {
+        unique_terms(
+            keys.iter()
