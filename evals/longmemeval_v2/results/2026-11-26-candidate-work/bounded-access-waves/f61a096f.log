FULL_HISTORY_QUERY {"duration_us":127809,"elapsed_ms":23483.253209000002,"sql":"RETURN { LET $pool = (SELECT id AS record, episode_id, t_ref, { LET $normalized = string::lowercase(content); RETURN IF $normalized CONTAINSALL $queries THEN array::repeat(true, array::len($queries)) ELSE IF $normalized CONTAINSANY $queries THEN [$normalized CONTAINS $queries[0], $normalized CONTAINS $queries[1], $normalized CONTAINS $queries[2], $normalized CONTAINS $queries[3], $normalized CONTAINS $queries[4], $normalized CONTAINS $queries[5], $normalized CONTAINS $queries[6], $normalized CONTAINS $queries[7]] ELSE array::repeat(false, array::len($queries)) END; } AS matched_terms FROM episode WHERE t_ref <= type::datetime($cutoff) AND (t_ingested IS NONE OR t_ingested <= type::datetime($cutoff))); RETURN (SELECT VALUE hit[1].* FROM (SELECT episode_id, array::min([term_rank, record, episode_id, t_ref]) AS hit FROM array::flatten(array::map($term_ranks, |$term_rank| (SELECT record, episode_id, t_ref, $term_rank AS term_rank FROM $pool WHERE matched_terms[$term_rank] = true ORDER BY t_ref DESC, episode_id ASC LIMIT $limit))) GROUP BY episode_id) WHERE episode_id NOT IN $seen ORDER BY hit[0] ASC, hit[3] DESC, hit[2] ASC); }"}
