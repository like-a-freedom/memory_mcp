    },
    "user_prompt": {
      "command": "memory-mcp-host-bridge",
      "args": ["--host", "claude_code", "--event", "user_prompt"]
    },
    "pre_tool": {
      "command": "memory-mcp-host-bridge",
      "args": ["--host", "claude_code", "--event", "pre_tool"]
    },
    "post_tool": {
      "command": "memory-mcp-host-bridge",
