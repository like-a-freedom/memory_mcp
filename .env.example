# SurrealDB database name (string). Examples: memory, testdb, production_db
SURREALDB_DB_NAME=memory

# SurrealDB connection URL (WebSocket RPC). If omitted/empty, embedded RocksDB mode will be used.
# Format: ws://HOST:PORT/rpc or wss://HOST:PORT/rpc
SURREALDB_URL=ws://127.0.0.1:8000/rpc

# One namespace (default: main). Example: org
SURREALDB_NAMESPACE=org

# SurrealDB credentials
SURREALDB_USERNAME=root
SURREALDB_PASSWORD=root

# Logging level (standard RUST_LOG env). Allowed: trace | debug | info | warn | error
RUST_LOG=info

# Optional: write structured log events to a file instead of stderr.
# Useful for MCP hosts that do not expose the server's stderr.
# The file is created if missing (parent directory must exist), opened in
# append mode (no rotation), and flushed after every line.
# On open failure the process falls back to stderr with a warning.
# MEMORY_LOG_FILE=/var/log/memory_mcp/memory_mcp.log

# Persist assemble_context analytics to query_log (disabled by default)
QUERY_LOGGING_ENABLED=false

# Days to retain query_log analytics rows before pruning old entries
QUERY_LOG_RETENTION_DAYS=90

# Optional: force embedded engine (true|false). Prefer to leave unset and rely on SURREALDB_URL inference.
SURREALDB_EMBEDDED=true

# Optional: data directory for embedded RocksDB (used when embedded=true or when SURREALDB_URL is not set)
# SURREALDB_DATA_DIR=./data/surrealdb

# Optional: embedding dimension for HNSW indexes.
# Common values:
# - text-embedding-3-small = 1536
# - nomic-embed-text = 768
# - mxbai-embed-large = 1024
# If you change this for an existing database, drop and recreate the embedding
# indexes (or rebuild the DB) before writing vectors with the new dimension.
# SURREALDB_EMBEDDING_DIMENSION=1536

# Optional semantic embedding integration (disabled by default).
# Without this, the MCP still works fully using lexical + community retrieval.
EMBEDDINGS_ENABLED=false

# Provider kind: local-candle | openai-compatible | ollama
# EMBEDDINGS_PROVIDER=local-candle

# Provider API base URL.
# Local-candle runs in-process and does not use a base URL.
# OpenAI-compatible default: https://api.openai.com/v1
# Ollama default: http://127.0.0.1:11434
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1

# Model name sent to the provider.
# Local-candle default: intfloat/multilingual-e5-small
# EMBEDDINGS_MODEL=intfloat/multilingual-e5-small

# Optional model cache directory for local-candle.
# EMBEDDINGS_MODEL_DIR=./data/models/intfloat/multilingual-e5-small

# Optional max token budget before local-candle chunks long inputs.
# EMBEDDINGS_MAX_TOKENS=384

# Optional bearer token for OpenAI-compatible providers.
# EMBEDDINGS_API_KEY=your_api_key_here

# Embedding request timeout in seconds.
# EMBEDDINGS_TIMEOUT_SECS=15

# Initial delay before probing a remote provider after degraded startup.
# Failed probes use 15s, 30s, ... up to 300s.
# EMBEDDINGS_RECOVERY_INTERVAL_SECS=60

# Automatic in-process recovery is enabled by default. Set false to keep the
# startup-degraded behavior until the next process restart/operator action.
# EMBEDDINGS_AUTO_RECOVERY=true

# Minimum cosine similarity required for semantic matches.
# Raise this to reduce false positives; lower it to increase recall.
# EMBEDDINGS_SIMILARITY_THRESHOLD=0.7

# Lifecycle background jobs (disabled by default)
# Enable background workers for memory hygiene (decay + archival)
LIFECYCLE_ENABLED=false

# Interval for decay worker (seconds) - how often to check for stale facts
LIFECYCLE_DECAY_INTERVAL_SECS=3600

# Interval for archival worker (seconds) - how often to archive old episodes
LIFECYCLE_ARCHIVAL_INTERVAL_SECS=86400

# Confidence threshold below which facts are marked invalid (0.0-1.0)
LIFECYCLE_DECAY_THRESHOLD=0.3

# Days after which episodes without active facts are archived
LIFECYCLE_ARCHIVAL_AGE_DAYS=90

# Half-life in days for confidence decay computation.
# Default: 365
# LIFECYCLE_DECAY_HALF_LIFE_DAYS=365

# NER extractor selection.
# Backend: anno (default, lightweight) | regex | anno-onnx |
#          urchade/gliner_multi-v2.1 (Candle GLiNER) |
#          VAGOsolutions/SauerkrautLM-LFM2.5-GLiNER (Candle LFM2 GLiNER)
# Unknown values are rejected. The removed NER_PROVIDER / NER_MODEL /
# NER_MODEL_DIR / NER_BATCH_SIZE variables fail with migration guidance.
# NER_EXTRACTOR=anno

# Artifact store root for model-backed extractors (Anno ONNX, GLiNER).
# NER_CACHE_DIR=./data/models/ner

# Optional comma-separated labels for model-backed extractors.
# Default: person,company,location,product,event,technology
# NER_LABELS=person,company,location,product,event,technology,date

# Optional confidence threshold for model-backed entity acceptance.
# NER_THRESHOLD=0.5

# Concurrent local NER inference limit.
# NER_MAX_CONCURRENCY=1

# Seconds of inactivity before a model-backed extractor unloads its model.
# 0 keeps it loaded for the process lifetime.
# NER_IDLE_UNLOAD_SECS=0

# GLiNER batching (native Candle backends only).
# GLINER_BATCH_SIZE=1
# GLINER_MAX_BATCH_TOKENS=1536

# Device for native Candle GLiNER backends: cpu | metal | auto.
# metal requires --features metal; auto uses Metal when available.
# GLINER_DEVICE=cpu

# Fuzzy-match threshold for entity alias resolution (0.0-1.0).
# ENTITY_FUZZY_THRESHOLD=0.85

# Claim relations rollout stage: disabled | shadow | relations | evidence.
# MEMORY_CLAIM_ROLLOUT_STAGE=shadow

# Claim candidate pagination (positive integer).
# MEMORY_CLAIM_CANDIDATE_PAGE_SIZE=50

# Inline claim-candidate limit per ingest (positive integer).
# MEMORY_CLAIM_INLINE_CANDIDATE_LIMIT=20

# Inline claim extraction time budget in milliseconds (positive integer).
# MEMORY_CLAIM_INLINE_BUDGET_MS=2000

# Listen address for the optional Prometheus metrics endpoint
# (requires --features prometheus).
# MEMORY_PROMETHEUS_LISTEN_ADDR=127.0.0.1:9100
